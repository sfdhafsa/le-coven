<section class="lineup section-shell" id="artistes" aria-labelledby="lineup-title">
  <div class="section-heading">
    <p class="eyebrow">La prochaine édition</p>
    <h2 id="lineup-title">Artistes</h2>
  </div>
  <p id="lineup-status" class="lineup-status" role="status">Chargement des artistes…</p>
  <ul id="lineup-grid" class="lineup-grid" aria-label="Artistes du festival" hidden></ul>
  <button id="lineup-retry" class="button button-outline" type="button" hidden>Réessayer</button>
  <noscript><p>Activez JavaScript pour découvrir les artistes du festival.</p></noscript>
</section>

<script>
  import { getLineup } from "../lib/lineup";

  const grid = document.querySelector<HTMLUListElement>("#lineup-grid")!;
  const status = document.querySelector<HTMLParagraphElement>("#lineup-status")!;
  const retry = document.querySelector<HTMLButtonElement>("#lineup-retry")!;

  async function load() {
    retry.hidden = true;
    status.hidden = false;
    status.textContent = "Chargement des artistes…";
    grid.setAttribute("aria-busy", "true");
    try {
      const artists = await getLineup();
      const cards = artists.map(artist => {
        const card = document.createElement("li");
        card.className = "artist-card";
        const portrait = document.createElement("div");
        portrait.className = "artist-portrait";
        const monogram = document.createElement("span");
        monogram.textContent = artist.nom.slice(0, 1);
        monogram.setAttribute("aria-hidden", "true");
        portrait.append(monogram);
        if (artist.imageUrl) {
          const image = document.createElement("img");
          image.src = artist.imageUrl;
          image.alt = "";
          image.loading = "lazy";
          image.width = 600;
          image.height = 600;
          image.addEventListener("error", () => image.remove(), { once: true });
          portrait.append(image);
        }
        const copy = document.createElement("div");
        copy.className = "artist-copy";
        const title = document.createElement("h3");
        title.textContent = artist.nom;
        copy.append(title);
        for (const [className, text] of [["artist-genres", artist.genres], ["artist-bio", artist.biographieCourte]]) {
          if (!text) continue;
          const paragraph = document.createElement("p");
          paragraph.className = className;
          paragraph.textContent = text;
          copy.append(paragraph);
        }
        card.append(portrait, copy);
        return card;
      });
      grid.replaceChildren(...cards);
      grid.hidden = !cards.length;
      status.hidden = !!cards.length;
      status.textContent = cards.length ? "" : "La programmation sera dévoilée prochainement.";
    } catch (error) {
      console.error("Blue Moon: impossible de charger les artistes.", error);
      status.textContent = "La programmation est momentanément indisponible. Réessayez dans quelques instants.";
      retry.hidden = false;
    } finally {
      grid.setAttribute("aria-busy", "false");
    }
  }
  retry.addEventListener("click", load);
  void load();
</script>
