---
import FestivalBrand from "../components/FestivalBrand.astro";
import "../styles/global.css";
import ArtistLineup from "../components/ArtistLineup.astro";

const covenUrl = (import.meta.env.PUBLIC_COVEN_URL || "http://localhost:4321").replace(/\/$/, "");
const links = [
  { label: "Accueil", href: "/" },
  { label: "Line-up", href: "/line-up" },
  { label: "Infos pratiques", href: "/infos-pratiques" },
  { label: "Billetterie", href: "/billetterie" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050410" />
    <meta name="description" content="Découvrez les artistes du festival Blue Moon." />
    <title>Line-up · Blue Moon</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Navigation principale">
        <FestivalBrand />
        <ul class="desktop-nav">
          {links.map(link => (
            <li>
              <a
                href={link.href}
                class:list={["nav-link", link.href === "/line-up" && "is-active"]}
                aria-current={link.href === "/line-up" ? "page" : undefined}
              >{link.label}</a>
            </li>
          ))}
        </ul>
        <div class="header-actions">
          <a class="button button-primary header-ticket" href="/billetterie">Billetterie <span aria-hidden="true">↗</span></a>
          <a class="coven-link" href={covenUrl}>← LECOVEN.FR</a>
          <button class="menu-toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button>
        </div>
      </nav>
      <nav id="mobile-nav" aria-label="Navigation mobile" hidden>
        {links.map(link => <a href={link.href} aria-current={link.href === "/line-up" ? "page" : undefined}>{link.label}</a>)}
        <a href={covenUrl}>← Retour au Coven</a>
      </nav>
    </header>

    <main id="main">
      <ArtistLineup />
    </main>

    <footer class="section-shell">
      <span>Blue Moon · Une production Le Coven</span>
      <a href={covenUrl + "/mentions-legales"}>Mentions légales ↗</a>
    </footer>

    <script>
      const menuButton = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const menu = document.querySelector<HTMLElement>("#mobile-nav");
      const closeMenu = () => {
        if (!menu || !menuButton) return;
        menu.hidden = true;
        menuButton.setAttribute("aria-expanded", "false");
        menuButton.setAttribute("aria-label", "Ouvrir le menu");
      };
      menuButton?.addEventListener("click", () => {
        if (!menu) return;
        const open = menu.hidden;
        menu.hidden = !open;
        menuButton.setAttribute("aria-expanded", String(open));
        menuButton.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
      });
      menu?.querySelectorAll("a").forEach(link => link.addEventListener("click", closeMenu));
      document.addEventListener("keydown", event => { if (event.key === "Escape") closeMenu(); });
      matchMedia("(min-width: 1200px)").addEventListener("change", event => { if (event.matches) closeMenu(); });
    </script>
  </body>
</html>
