---
import "../styles/global.css";
const covenUrl = (import.meta.env.PUBLIC_COVEN_URL ?? "http://localhost:4321").replace(/\/$/, "");
const ticketUrl = import.meta.env.PUBLIC_TICKETING_URL;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Le site du festival Blue Moon : retrouvez prochainement la programmation et les informations de la prochaine édition." />
    <title>Blue Moon — Le festival</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="shell site-nav" aria-label="Navigation principale">
        <a class="site-brand" href="/" aria-current="page">Blue Moon</a>
        <a href={covenUrl + "/blue-moon"}>Le festival et Le Coven ↗</a>
      </nav>
    </header>
    <main>
      <section class="hero" aria-labelledby="festival-title">
        <div class="hero-image" aria-hidden="true"></div>
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-content shell">
          <p class="festival-meta">La prochaine lune approche</p>
          <h1 id="festival-title"><span>Blue</span><span>Moon</span></h1>
          <p class="festival-label">Festival</p>
          <p class="festival-announcement">Dates, artistes et programme de la prochaine édition seront annoncés ici prochainement.</p>
          <div class="hero-actions">
            {ticketUrl && <a class="button button-primary" href={ticketUrl}>Billetterie ↗</a>}
            <a class="button button-outline" href={covenUrl + "/blue-moon"}>Découvrir le festival avec Le Coven ↗</a>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
<style>
  .festival-announcement { max-width: 38rem; margin: 2rem 0 0; color: #ddcbed; line-height: 1.7; }
  .site-nav > a:last-child { font-size: .85rem; text-align: right; }
</style>
