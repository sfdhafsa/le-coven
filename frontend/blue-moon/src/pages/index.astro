---
import "../styles/global.css";
import ArtistLineup from "../components/ArtistLineup.astro";
const covenUrl = (import.meta.env.PUBLIC_COVEN_URL || "http://localhost:4321").replace(/\/$/, "");
const ticketUrl = import.meta.env.PUBLIC_TICKETING_URL;
const volunteerUrl = import.meta.env.PUBLIC_VOLUNTEER_URL;
const links = [
  { label: "Accueil", href: "#accueil" },
  { label: "Infos pratiques", href: "#infos-pratiques" },
  { label: "Billetterie", href: ticketUrl || "#billetterie" },
  { label: "Bénévolat", href: volunteerUrl || "#benevolat" },
  { label: "Contact", href: "#contact" },
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050410" />
    <meta name="description" content="" />
    <title>Festival</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Navigation principale">
        <a class="brand" href="#accueil" aria-label="Blue Moon, accueil">
          <img src="/images/logo-le-coven.jpeg" alt="" width="42" height="42" />
          <span><strong>Blue Moon</strong><small>Festival</small></span>
        </a>
        <ul class="desktop-nav">{links.map((link, i) => <li><a href={link.href} class:list={["nav-link", i === 0 && "is-active"]} aria-current={i === 0 ? "page" : undefined}>{link.label}</a></li>)}</ul>
        <div class="header-actions">
          <a class="button button-primary header-ticket" href={ticketUrl || "#billetterie"}>Billetterie <span aria-hidden="true">↗</span></a>
          <a class="coven-link" href={covenUrl}>← LECOVEN.FR</a>
          <button class="menu-toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button>
        </div>
      </nav>
      <nav id="mobile-nav" aria-label="Navigation mobile" hidden>
        {links.map(link => <a href={link.href}>{link.label}</a>)}
        <a href={covenUrl}>← Retour au Coven</a>
      </nav>
    </header>
    <main id="main">
      <section class="hero" id="accueil" aria-labelledby="festival-title">
        <div class="hero-image" aria-hidden="true"></div>
        <div class="hero-glow" aria-hidden="true"></div>
        <span class="star star-one" aria-hidden="true"></span><span class="star star-two" aria-hidden="true"></span><span class="star star-three" aria-hidden="true"></span><span class="star star-four" aria-hidden="true"></span>
        <div class="hero-content">
          <p class="festival-meta" id="edition-meta" hidden></p>
          <h1 id="festival-title"><span>Blue</span><span>Moon</span></h1>
          <p class="festival-label">Festival · Une production Le Coven</p>
          <p id="edition-description" class="cms-description" hidden></p>
          <div class="hero-actions">
            <a class="button button-primary" href="#infos-pratiques">Infos pratiques <span aria-hidden="true">→</span></a>
            <a class="button button-outline" href={ticketUrl || "#billetterie"}>Billetterie <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>
      <section class="next-edition section-shell" id="prochaine-edition" aria-labelledby="next-edition-title" hidden>
        <div class="section-heading">
          <p class="eyebrow">Le prochain rendez-vous</p>
          <h2 id="next-edition-title">Prochaine édition</h2>
        </div>
        <div class="next-edition-card">
          <h3 id="next-edition-name"></h3>
          <p class="next-edition-meta" id="next-edition-meta"></p>
          <p class="next-edition-description" id="next-edition-description" hidden></p>
        </div>
      </section>
      <ArtistLineup />
      <section class="festival-story section-shell" id="origine" aria-labelledby="origin-title">
        <div class="story-heading">
          <p class="eyebrow">L’esprit du festival</p>
          <h2 id="origin-title">Blue Moon :<br /><span>origine et histoire</span></h2>
        </div>
        <div class="story-copy">
          <p class="story-intro">Une lune singulière, une occasion de se retrouver.</p>
          <p>En anglais, <em>blue moon</em> désigne notamment la seconde pleine lune d’un même mois calendaire. Ce rendez-vous peu fréquent porte un nom évocateur : la lune bleue.</p>
          <p>Avec Blue Moon, Le Coven célèbre cette lune en réunissant ses collectifs autour des musiques électroniques et de la création artistique. Concerts, expositions et expériences visuelles composent cette rencontre collective.</p>
          <div class="story-sources" aria-label="En savoir plus sur Blue Moon">
            <a href="https://shotgun.live/en/festivals/blue-moon" target="_blank" rel="noopener noreferrer">Le festival sur Shotgun ↗</a>
            <a href="https://science.nasa.gov/solar-system/moon/super-blue-moons-your-questions-answered/" target="_blank" rel="noopener noreferrer">Comprendre la lune bleue · NASA ↗</a>
          </div>
        </div>
      </section>
      <section class="information section-shell" id="infos-pratiques" aria-labelledby="info-title">
        <div class="section-heading"><h2 id="info-title">Informations pratiques</h2></div>
        <div class="info-grid" id="venue-grid"></div>
        <div class="info-grid" id="practical-grid"></div>
        <p id="practical-status" role="status"></p>
        <div class="info-grid">
          <article id="billetterie" hidden><h3>Billetterie</h3><a id="ticket-link" class="text-link">Accéder à la billetterie ↗</a></article>
          <article id="benevolat" hidden><h3>Bénévolat</h3><a id="volunteer-link" class="text-link">Rejoindre l’aventure ↗</a></article>
        </div>
      </section>
      <section class="contact-section section-shell" id="contact" hidden><h2>Contact</h2><a id="contact-link" class="button button-outline">Nous contacter ↗</a></section>
    </main>
    <footer class="section-shell"><span>Blue Moon · Une production Le Coven</span><a href={covenUrl + "/mentions-legales"}>Mentions légales ↗</a></footer>
    <noscript><p class="section-shell">Activez JavaScript pour charger les informations du festival.</p></noscript>
    <script>
      import "../lib/homepage";
      const menuButton = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const menu = document.querySelector<HTMLElement>("#mobile-nav");
      const closeMenu = () => { if (!menu || !menuButton) return; menu.hidden = true; menuButton.setAttribute("aria-expanded", "false"); menuButton.setAttribute("aria-label", "Ouvrir le menu"); };
      menuButton?.addEventListener("click", () => { if (!menu) return; const open = menu.hidden; menu.hidden = !open; menuButton.setAttribute("aria-expanded", String(open)); menuButton.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu"); });
      menu?.querySelectorAll("a").forEach(link => link.addEventListener("click", closeMenu));
      document.addEventListener("keydown", event => { if (event.key === "Escape") closeMenu(); });
      matchMedia("(min-width: 1200px)").addEventListener("change", event => { if (event.matches) closeMenu(); });
    </script>
  </body>
</html>
