---
import "../../styles/global.css";
import { collection, mediaUrl, safeUrl, type Block, type Media } from "../../lib/strapi";

interface Artist {
  documentId: string;
  nom: string;
  slug: string;
  biographie?: Block[];
  biographieCourte?: string;
  genres?: string;
  imageProfil?: Media;
  lienInstagram?: string;
  lienFacebook?: string;
  lienSoundcloud?: string;
  lienSpotify?: string;
  lienSiteWeb?: string;
}

export async function getStaticPaths() {
  const artists: Artist[] = [];
  let page = 1;
  let pageCount = 1;
  do {
    const result = await collection<Artist>("artists", {
      "populate[imageProfil]": "true",
      "pagination[pageSize]": "100",
      "pagination[page]": String(page),
      "sort[0]": "nom:asc",
    });
    artists.push(...result.data);
    pageCount = result.meta?.pagination?.pageCount || 1;
    page++;
  } while (page <= pageCount);

  return artists
    .filter(artist => artist.slug)
    .map(artist => ({ params: { slug: artist.slug }, props: { artist } }));
}

interface Props { artist: Artist }
const { artist } = Astro.props;
const covenUrl = (import.meta.env.PUBLIC_COVEN_URL || "http://localhost:4321").replace(/\/$/, "");
const portrait = mediaUrl(artist.imageProfil);
const socialLinks = [
  ["Instagram", safeUrl(artist.lienInstagram)],
  ["Facebook", safeUrl(artist.lienFacebook)],
  ["SoundCloud", safeUrl(artist.lienSoundcloud)],
  ["Spotify", safeUrl(artist.lienSpotify)],
  ["Site officiel", safeUrl(artist.lienSiteWeb)],
].filter((item): item is [string, string] => Boolean(item[1]));

function blockText(block?: Block): string {
  if (!block) return "";
  return [block.text, ...(block.children || []).map(blockText)].filter(Boolean).join("");
}
const biography = (artist.biographie || []).map(blockText).filter(Boolean);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050410" />
    <meta name="description" content={artist.biographieCourte || `Découvrez ${artist.nom}, artiste du festival Blue Moon.`} />
    <title>{artist.nom} · Blue Moon</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Navigation principale">
        <a class="brand" href="/" aria-label="Blue Moon, accueil">
          <img src="/images/logo-le-coven.jpeg" alt="" width="42" height="42" />
          <span><strong>Blue Moon</strong><small>Festival</small></span>
        </a>
        <ul class="desktop-nav">
          <li><a class="nav-link" href="/">Accueil</a></li>
          <li><a class="nav-link" href="/infos-pratiques">Infos pratiques</a></li>
          <li><a class="nav-link" href="/billetterie">Billetterie</a></li>
        </ul>
        <div class="header-actions">
          <a class="button button-primary header-ticket" href="/billetterie">Billetterie <span aria-hidden="true">↗</span></a>
          <a class="coven-link" href={covenUrl}>← LECOVEN.FR</a>
        </div>
      </nav>
    </header>

    <main id="main" class="artist-detail section-shell">
      <a class="artist-back" href="/#artistes">← Retour aux artistes</a>
      <article class="artist-detail-hero">
        <div class="artist-detail-portrait">
          <span aria-hidden="true">{artist.nom.slice(0, 1)}</span>
          {portrait && <img src={portrait} alt={`Portrait de ${artist.nom}`} width="900" height="1100" />}
        </div>
        <div class="artist-detail-copy">
          <p class="eyebrow">Artiste · Blue Moon</p>
          <h1 class="artist-detail-title">{artist.nom}</h1>
          {artist.genres && <p class="artist-detail-genres">{artist.genres}</p>}
          {artist.biographieCourte && <p class="artist-detail-intro">{artist.biographieCourte}</p>}
          {socialLinks.length > 0 && (
            <nav class="artist-socials" aria-label={`Liens de ${artist.nom}`}>
              {socialLinks.map(([label, href]) => <a href={href} target="_blank" rel="noopener noreferrer">{label} ↗</a>)}
            </nav>
          )}
        </div>
      </article>

      {(biography.length > 0 || (!artist.biographieCourte && artist.genres)) && (
        <section class="artist-biography" aria-labelledby="artist-biography-title">
          <p class="eyebrow">À propos</p>
          <h2 id="artist-biography-title">Biographie</h2>
          {biography.map(paragraph => <p>{paragraph}</p>)}
        </section>
      )}
    </main>

    <footer class="section-shell">
      <span>Blue Moon · Une production Le Coven</span>
      <a href={covenUrl + "/mentions-legales"}>Mentions légales ↗</a>
    </footer>
    <script>
      const portrait = document.querySelector<HTMLImageElement>(".artist-detail-portrait img");
      const removeUnavailablePortrait = () => portrait?.remove();
      if (portrait?.complete && portrait.naturalWidth === 0) removeUnavailablePortrait();
      else portrait?.addEventListener("error", removeUnavailablePortrait, { once: true });
    </script>
  </body>
</html>
