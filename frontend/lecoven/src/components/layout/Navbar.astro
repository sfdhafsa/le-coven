---
import Container from "../ui/Container.astro";

const links = [
  { label: "Accueil", href: "/" },
  { label: "Le Coven", href: "/le-coven" },
  { label: "Événements", href: "/events" },
  { label: "Blue Moon", href: import.meta.env.PUBLIC_BLUE_MOON_URL ?? "http://localhost:4322" },
  { label: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);
---

<header class="site-header">
  <Container size="wide" class="site-header__container">
    <nav class="site-nav" aria-label="Navigation principale">
      <a class="site-brand" href="/" aria-label="Le Coven, accueil">
        <img
          src="/images/logo-le-coven.jpeg"
          alt=""
          width="88"
          height="88"
        />
        <span class="site-brand__name">Le Coven</span>
      </a>

      <ul class="desktop-navigation">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
              class:list={["nav-link", isCurrent(link.href) && "nav-link--active"]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        aria-label="Ouvrir le menu"
      >
        <span></span><span></span><span></span>
      </button>
    </nav>
  </Container>

  <div id="mobile-navigation" class="mobile-navigation" hidden>
    <Container size="wide">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
              class:list={["mobile-nav-link", isCurrent(link.href) && "mobile-nav-link--active"]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </div>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const mobileNavigation = document.querySelector<HTMLElement>("#mobile-navigation");

  const closeMenu = () => {
    if (!menuButton || !mobileNavigation) return;
    mobileNavigation.hidden = true;
    menuButton.setAttribute("aria-expanded", "false");
    menuButton.setAttribute("aria-label", "Ouvrir le menu");
    document.body.classList.remove("menu-open");
  };

  menuButton?.addEventListener("click", () => {
    if (!mobileNavigation) return;
    const willOpen = mobileNavigation.hidden;
    mobileNavigation.hidden = !willOpen;
    menuButton.setAttribute("aria-expanded", String(willOpen));
    menuButton.setAttribute("aria-label", willOpen ? "Fermer le menu" : "Ouvrir le menu");
    document.body.classList.toggle("menu-open", willOpen);
  });

  mobileNavigation?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768) closeMenu();
  });
</script>
