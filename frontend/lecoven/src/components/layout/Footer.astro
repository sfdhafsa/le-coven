---
import Container from "../ui/Container.astro";

const currentYear = new Date().getFullYear();
const helloAssoUrl = import.meta.env.PUBLIC_HELLOASSO_URL ?? "https://www.helloasso.com/associations/le-coven";
const shotgunUrl = import.meta.env.PUBLIC_SHOTGUN_URL ?? "https://shotgun.live/fr/festivals/blue-moon";
const shopUrl = import.meta.env.PUBLIC_SHOP_URL ?? "https://www.helloasso.com/associations/le-coven/boutiques/blue-moon-festival";
const donateUrl = import.meta.env.PUBLIC_DONATE_URL ?? "https://www.helloasso.com/associations/le-coven/formulaires/1";
---

<footer class="site-footer">
  <Container size="wide">
    <div class="footer-minimal">
      <a class="footer-email" href="mailto:lecoven@etik.com">lecoven@etik.com</a>
      <nav class="footer-social" aria-label="Réseaux sociaux">
        <a href={import.meta.env.PUBLIC_INSTAGRAM_URL ?? "https://www.instagram.com/lecoven.asso/"} rel="noreferrer" target="_blank">Instagram</a>
        <a href={import.meta.env.PUBLIC_FACEBOOK_URL ?? "https://www.facebook.com/LeCoven.asso"} rel="noreferrer" target="_blank">Facebook</a>
        <a href="https://linktr.ee/LeCoven.asso" rel="noreferrer" target="_blank">Tous les liens</a>
        <a href={helloAssoUrl} rel="noreferrer" target="_blank">HelloAsso</a>
        <a href={shotgunUrl} rel="noreferrer" target="_blank">Shotgun</a>
        <a href={shopUrl} rel="noreferrer" target="_blank">Boutique</a>
        <a href={donateUrl} rel="noreferrer" target="_blank">Faire un don</a>
      </nav>
      <nav class="footer-legal" aria-label="Liens légaux">
        <a href="/mentions-legales">Mentions légales</a>
      </nav>
      <p class="footer-copyright">© {currentYear} Le Coven</p>
    </div>
  </Container>
</footer>
