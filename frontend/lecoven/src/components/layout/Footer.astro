---
import Container from "../ui/Container.astro";

const navigationLinks = [
  { label: "Accueil", href: "/" },
  { label: "Le Coven", href: "/le-coven" },
  { label: "Événements", href: "/events" },
  { label: "Blue Moon Festival", href: "/blue-moon" },
  { label: "Contact", href: "/contact" },
];

const associationLinks = [
  { label: "Mission", href: "/le-coven#mission" },
  { label: "Cour Centrale", href: "/le-coven#cour-centrale" },
  { label: "Les collectifs", href: "/collectifs" },
  { label: "Adhésion", href: "/adhesion" },
];

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <Container size="wide">
    <div class="footer-grid">
      <div>
        <a class="footer-brand" href="/" aria-label="Le Coven, accueil">
          <img src="/images/logo-le-coven.jpeg" alt="" width="80" height="80" loading="lazy" />
          <span>LE COVEN</span>
        </a>
        <p class="footer-summary">
          Fédération de collectifs underground pour la culture électronique et les arts alternatifs.
        </p>
      </div>

      <div>
        <h2 class="footer-heading">Navigation</h2>
        <ul class="footer-list">
          {navigationLinks.map((link) => <li><a class="footer-link" href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">L’asso</h2>
        <ul class="footer-list">
          {associationLinks.map((link) => <li><a class="footer-link" href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">Contact</h2>
        <address class="footer-list not-italic">
          <a class="footer-link block break-all" href="mailto:lecoven@etik.com">lecoven@etik.com</a>
          <a class="footer-link block break-all" href="mailto:administration@lecoven.fr">administration@lecoven.fr</a>
        </address>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {currentYear} Le Coven — Association loi 1901</p>
      <nav class="footer-legal" aria-label="Liens légaux">
        <a href="/mentions-legales">Mentions légales</a>
        <span aria-hidden="true">·</span>
        <a href="/confidentialite">Confidentialité</a>
      </nav>
    </div>
  </Container>
</footer>
