---
import Container from "../ui/Container.astro";

const currentYear = new Date().getFullYear();
const licenceNumbers = (import.meta.env.PUBLIC_LICENCE_NUMBERS ?? "PLATESV-D-2024-006881,3-011359")
  .split(",")
  .map((licence: string) => licence.trim())
  .filter(Boolean);
---

<footer class="site-footer">
  <Container size="wide">
    <div class="footer-minimal">
      <a class="footer-email" href="mailto:lecoven@etik.com">lecoven@etik.com</a>
      <nav class="footer-social" aria-label="Réseaux sociaux">
        <a href={import.meta.env.PUBLIC_INSTAGRAM_URL ?? "https://www.instagram.com/lecoven.asso/"} rel="noreferrer" target="_blank">Instagram</a>
        <a href={import.meta.env.PUBLIC_FACEBOOK_URL ?? "https://www.facebook.com/LeCoven.asso"} rel="noreferrer" target="_blank">Facebook</a>
        <a href="https://linktr.ee/LeCoven.asso" rel="noreferrer" target="_blank">Tous les liens</a>
      </nav>
      {licenceNumbers.length > 0 && (
        <p class="footer-licences">Licences : {licenceNumbers.join(" · ")}</p>
      )}
      <nav class="footer-legal" aria-label="Liens légaux">
        <a href="/mentions-legales">Mentions légales</a>
      </nav>
      <p class="footer-copyright">© {currentYear} Le Coven — RNA W595043038</p>
    </div>
  </Container>
</footer>
