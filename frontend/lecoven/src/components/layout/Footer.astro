---
const navigationLinks = [
  { label: "Accueil", href: "/" },
  { label: "Le Coven", href: "/le-coven" },
  { label: "Événements", href: "/events" },
  { label: "Blue Moon Festival", href: "/blue-moon" },
  { label: "Contact", href: "/contact" },
];

const associationLinks = [
  { label: "Mission", href: "/le-coven#mission" },
  { label: "Cour Centrale", href: "/le-coven#cour-centrale" },
  { label: "Les collectifs", href: "/collectifs" },
  { label: "Adhésion", href: "/adhesion" },
];

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="mx-auto max-w-[86rem] px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.25fr_1fr_1fr_1fr] lg:gap-16">
      <div>
        <a class="group inline-flex items-center gap-3" href="/" aria-label="Le Coven, accueil">
          <img
            class="size-10 rounded-full border border-violet-400/30 object-cover shadow-[0_0_18px_rgba(168,85,247,0.16)]"
            src="/images/logo-le-coven.jpeg"
            alt=""
            width="80"
            height="80"
            loading="lazy"
          />
          <span class="text-sm font-extrabold tracking-[0.18em] text-violet-50">LE COVEN</span>
        </a>

        <p class="mt-5 max-w-xs text-sm leading-7 text-violet-200/45">
          Fédération de collectifs underground pour la culture électronique et les arts alternatifs.
        </p>
      </div>

      <div>
        <h2 class="footer-heading">Navigation</h2>
        <ul class="mt-6 space-y-4">
          {navigationLinks.map((link) => (
            <li><a class="footer-link" href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">L’asso</h2>
        <ul class="mt-6 space-y-4">
          {associationLinks.map((link) => (
            <li><a class="footer-link" href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">Contact</h2>
        <address class="mt-6 space-y-4 not-italic">
          <a class="footer-link block break-all" href="mailto:lecoven@etik.com">lecoven@etik.com</a>
          <a class="footer-link block break-all" href="mailto:administration@lecoven.fr">
            administration@lecoven.fr
          </a>
        </address>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-5 border-t border-violet-400/10 pt-8 text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-violet-300/30 sm:mt-20 sm:flex-row sm:items-center sm:justify-between">
      <p>© {currentYear} Le Coven — Association loi 1901</p>

      <nav class="flex flex-wrap items-center gap-x-4 gap-y-2" aria-label="Liens légaux">
        <a class="transition hover:text-violet-200/70" href="/mentions-legales">Mentions légales</a>
        <span aria-hidden="true">·</span>
        <a class="transition hover:text-violet-200/70" href="/confidentialite">Confidentialité</a>
      </nav>
    </div>
  </div>
</footer>
