---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit" | "reset";
  class?: string;
  ariaLabel?: string;
  target?: "_blank" | "_self";
  rel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  class: className,
  ariaLabel,
  target,
  rel,
} = Astro.props;

const classes = ["c-button", `c-button--${variant}`, `c-button--${size}`, className];
const external = href ? /^https?:\/\//i.test(href) : false;
const linkTarget = target ?? (external ? "_blank" : undefined);
const linkRel = rel ?? (linkTarget === "_blank" ? "noopener noreferrer" : undefined);
---

{
  href ? (
    <a class:list={classes} href={href} aria-label={ariaLabel} target={linkTarget} rel={linkRel}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} type={type} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
