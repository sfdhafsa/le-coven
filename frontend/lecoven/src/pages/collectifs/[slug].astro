---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";

interface Collective {
  name: string;
  slug: string;
  description: string;
  websiteUrl?: string | null;
  instagramUrl?: string | null;
}

export async function getStaticPaths() {
  let collectives: Collective[] = [];

  try {
    const baseUrl = (import.meta.env.PUBLIC_STRAPI_URL ?? "http://localhost:1337").replace(/\/$/, "");
    const response = await fetch(`${baseUrl}/api/collectives`);
    if (response.ok) {
      const payload = await response.json();
      const entries = (payload.data ?? []).map((item: any) => ({
        name: item.name ?? item.nom ?? "Collectif",
        slug: item.slug,
        description: item.description ?? item.descriptionCourte ?? "",
        websiteUrl: item.websiteUrl ?? item.siteWeb,
        instagramUrl: item.instagramUrl ?? item.instagram,
      })).filter((item: Collective) => item.slug);
      collectives = entries;
    }
  } catch {
    collectives = [];
  }

  return collectives.map((collective) => ({ params: { slug: collective.slug }, props: { collective } }));
}

const { collective } = Astro.props as { collective: Collective };
---

<BaseLayout title={`${collective.name} — Les collectifs du Coven`} description={collective.description}>
  <article class="editorial-page collective-detail">
    <Container>
      <p class="c-eyebrow">Collectif du Coven</p>
      <h1>{collective.name}</h1>
      <p class="editorial-page__lead">{collective.description}</p>
      <div class="collective-detail__actions">
        {collective.websiteUrl && <Button href={collective.websiteUrl}>Découvrir le site</Button>}
        {collective.instagramUrl && <Button href={collective.instagramUrl} variant="secondary">Instagram</Button>}
        <Button href="/le-coven#collectifs" variant="ghost">Retour aux collectifs</Button>
      </div>
    </Container>
  </article>
</BaseLayout>
