---
import Button from "../components/ui/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";

const STRAPI_URL = (import.meta.env.PUBLIC_STRAPI_URL ?? "http://localhost:1337").replace(/\/$/, "");
const NEWSLETTER_URL = import.meta.env.PUBLIC_NEWSLETTER_URL
  ?? "https://b1c9556b.sibforms.com/serve/MUIFAMlvCQnwKT0TDIq_Q19GZh_j3QaprDfIsgk6mYmClCb-xg9eSvVnhZWFa_D9FidD5awxnmydpZs1VFneOx_YpqY55umNSfm5EAWdAEFAi4AjXOFTLSybMcCOTI4UB0nUWnkVopLhEeF1qGdzkztAYpM5MA2giy4qd2CRfJPjwrn9y4km8Wd7Y5XI93lf30-aigv51zJ5XUkHzQ==";
const DONATE_URL = import.meta.env.PUBLIC_DONATE_URL
  ?? "https://www.helloasso.com/associations/le-coven/formulaires/1";
const SHOP_URL = import.meta.env.PUBLIC_SHOP_URL
  ?? "https://www.helloasso.com/associations/le-coven/boutiques/blue-moon-festival";

interface Media {
  url?: string;
  formats?: { medium?: { url: string }; large?: { url: string } } | null;
}

interface EventEntry {
  title?: string;
  titre?: string;
  slug?: string;
  shortDescription?: string;
  descriptionCourte?: string;
  startDate?: string;
  dateDebut?: string;
  customLocation?: string;
  lieuLibre?: string;
  coverImage?: Media | null;
  imageCouverture?: Media | null;
}

const fallbackEvents = [
  {
    title: "La prochaine rencontre du Coven",
    slug: "",
    description: "La programmation complète sera annoncée prochainement.",
    date: null,
    location: "Hauts-de-France",
    image: "/images/hero-concert.jfif",
  },
  {
    title: "Blue Moon Festival",
    slug: "",
    description: "Artistes, collectifs et cultures électroniques réunis sous une même lune.",
    date: null,
    location: "Lieu à découvrir",
    image: "/images/hero-performer.png",
  },
];

let events = fallbackEvents;

try {
  const now = new Date().toISOString();
  const response = await fetch(
    `${STRAPI_URL}/api/events?filters[startDate][$gte]=${encodeURIComponent(now)}&populate=coverImage&sort=startDate:asc&pagination[pageSize]=6`,
  );
  if (response.ok) {
    const payload: { data?: EventEntry[] } = await response.json();
    const entries = (payload.data ?? []).map((event) => {
      const image = event.coverImage ?? event.imageCouverture;
      const imagePath = image?.formats?.large?.url ?? image?.formats?.medium?.url ?? image?.url;
      return {
        title: event.title ?? event.titre ?? "Événement Le Coven",
        slug: event.slug ?? "",
        description: event.shortDescription ?? event.descriptionCourte ?? "",
        date: event.startDate ?? event.dateDebut ?? null,
        location: event.customLocation ?? event.lieuLibre ?? "Le Coven",
        image: imagePath ? (imagePath.startsWith("http") ? imagePath : `${STRAPI_URL}${imagePath}`) : "/images/hero-concert.jfif",
      };
    });
    if (entries.length > 0) events = entries;
  }
} catch {
  // L’accueil reste disponible lorsque Strapi est en veille.
}

const formatDate = (date: string | null) => date
  ? new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" }).format(new Date(date))
  : "Bientôt annoncé";
---

<BaseLayout
  title="Le Coven — Fédération des collectifs électroniques"
  description="Le Coven fédère les collectifs de musiques électroniques des Hauts-de-France et soutient la création, la diffusion et les cultures alternatives."
>
  <section class="hero-stage isolate flex min-h-[calc(100svh-4.5rem)] items-center overflow-hidden px-5 py-12 sm:px-8 lg:px-12">
    <div class="hero-slideshow" aria-hidden="true">
      <span class="hero-slide hero-slide--concert"></span>
      <span class="hero-slide hero-slide--performer"></span>
    </div>

    <div class="hero-grid" aria-hidden="true"></div>
    <span class="cosmic-star left-[7%] top-[10%]" aria-hidden="true">✦</span>
    <span class="cosmic-star right-[10%] top-[20%]" aria-hidden="true">✦</span>
    <span class="cosmic-star bottom-[13%] right-[7%]" aria-hidden="true">✦</span>

    <div class="relative z-10 mx-auto flex w-full max-w-5xl flex-col items-center text-center">
      <div class="home-logo-lockup" aria-label="Logo Le Coven">
        <span class="home-logo-lockup__orbit" aria-hidden="true"></span>
        <img
          src="/images/logo-le-coven-v2.png"
          alt="Le Coven, croissants de lune entourant la lettre V"
          width="288"
          height="288"
          fetchpriority="high"
        />
      </div>

      <p class="c-eyebrow c-eyebrow--pill">
        Association culturelle <span aria-hidden="true">·</span> Musique électronique
      </p>

      <h1 class="hero-wordmark">
        <span class="sr-only">Le Coven</span>
        <img
          src="/images/le-coven-wordmark.png"
          alt=""
          width="551"
          height="207"
          fetchpriority="high"
          aria-hidden="true"
        />
      </h1>

      <p class="mt-10 max-w-2xl text-base leading-8 text-violet-100/65 sm:text-lg">
        Fédération de collectifs underground dédiée à la création, la diffusion et la promotion de la culture électronique et des arts alternatifs.
      </p>

      <div class="mt-10 flex w-full flex-col items-stretch justify-center gap-4 sm:w-auto sm:flex-row sm:items-center">
        <Button href="/events" size="lg">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M7 3v3m10-3v3M4.5 9.5h15M6 5h12a2 2 0 0 1 2 2v12H4V7a2 2 0 0 1 2-2Z"></path>
          </svg>
          Événements
        </Button>

        <Button href={"/blue-moon"} variant="secondary" size="lg">
          Blue Moon Festival
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </Button>
      </div>
    </div>
  </section>

  <section class="home-events" aria-labelledby="home-events-title">
    <Container size="wide">
      <div class="home-section-heading home-section-heading--row">
        <div>
          <p class="c-eyebrow">À l’agenda</p>
          <h2 id="home-events-title">Prochains événements</h2>
        </div>
        <div class="home-carousel-controls" aria-label="Contrôles du carrousel">
          <button type="button" data-event-previous aria-label="Événement précédent">←</button>
          <button type="button" data-event-next aria-label="Événement suivant">→</button>
        </div>
      </div>

      <div class="home-event-carousel" data-event-carousel tabindex="0">
        {events.map((event) => (
          <article class="home-event-card">
            <img src={event.image} alt="" loading="lazy" />
            <div class="home-event-card__overlay"></div>
            <div class="home-event-card__content">
              <p class="home-event-card__date">{formatDate(event.date)}</p>
              <h3>{event.title}</h3>
              <p>{event.description}</p>
              <span class="home-event-card__location">⌖ {event.location}</span>
              <Button href={event.slug ? `/events/${event.slug}` : "/events"} variant="secondary" size="sm">Découvrir</Button>
            </div>
          </article>
        ))}
      </div>
      <div class="home-section-link"><Button href="/events" variant="ghost">Voir tous les événements →</Button></div>
    </Container>
  </section>

  <section class="home-donation" id="nous-soutenir" aria-labelledby="home-donation-title">
    <Container size="wide">
      <div class="home-donation__panel">
        <div class="home-donation__copy">
          <p class="c-eyebrow">Nous soutenir</p>
          <h2 id="home-donation-title">Chaque don fait vivre nos événements</h2>
          <p>Votre soutien nous aide à rémunérer les artistes, accueillir les publics et développer de nouveaux projets culturels dans les Hauts-de-France.</p>
        </div>
        <div class="home-donation__actions">
          <a class="home-donation__button home-donation__button--shop" href={SHOP_URL} target="_blank" rel="noopener noreferrer">
            Découvrir la boutique
            <span aria-hidden="true">↗</span>
          </a>
          <a class="home-donation__button" href={DONATE_URL} target="_blank" rel="noopener noreferrer">
            Faire un don
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </Container>
  </section>

  <section class="home-blue-moon">
    <div class="home-blue-moon__image" aria-hidden="true"></div>
    <Container size="wide" class="home-blue-moon__content">
      <p class="c-eyebrow">Le festival du Coven</p>
      <h2>Blue Moon</h2>
      <p>Une célébration des artistes, des collectifs et des musiques électroniques, née de l’envie de créer une expérience libre, collective et hors du temps.</p>
      <Button href={"/blue-moon"} size="lg">Entrer dans l’univers Blue Moon</Button>
    </Container>
  </section>

  <section class="home-newsletter">
    <Container size="wide">
      <div class="home-newsletter__panel">
        <div>
          <p class="c-eyebrow">Rester dans le cercle</p>
          <h2>Les nouvelles du Coven</h2>
          <p>Programmation, appels à bénévoles et actualités : recevez l’essentiel sans bruit inutile.</p>
        </div>
        <div class="home-newsletter__action">
          <a
            class="home-newsletter__link"
            href={NEWSLETTER_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            S’inscrire à la newsletter
            <span aria-hidden="true">↗</span>
          </a>
          <p>Le formulaire d’inscription sécurisé s’ouvrira sur Brevo.</p>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  const carousel = document.querySelector<HTMLElement>("[data-event-carousel]");
  const previous = document.querySelector<HTMLButtonElement>("[data-event-previous]");
  const next = document.querySelector<HTMLButtonElement>("[data-event-next]");
  const moveCarousel = (direction: number) => {
    if (!carousel) return;
    carousel.scrollBy({ left: direction * Math.min(carousel.clientWidth * 0.88, 620), behavior: "smooth" });
  };
  previous?.addEventListener("click", () => moveCarousel(-1));
  next?.addEventListener("click", () => moveCarousel(1));
</script>
