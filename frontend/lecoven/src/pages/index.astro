---
import Button from "../components/ui/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Le Coven — Fédération des collectifs électroniques"
  description="Le Coven fédère les collectifs de musiques électroniques des Hauts-de-France et soutient la création, la diffusion et les cultures alternatives."
>
  <section class="hero-stage isolate flex min-h-[calc(100svh-4.5rem)] items-center overflow-hidden px-5 py-12 sm:px-8 lg:px-12">
    <div class="hero-slideshow" aria-hidden="true">
      <span class="hero-slide hero-slide--concert"></span>
      <span class="hero-slide hero-slide--performer"></span>
    </div>

    <div class="hero-grid" aria-hidden="true"></div>
    <span class="cosmic-star left-[7%] top-[10%]" aria-hidden="true">✦</span>
    <span class="cosmic-star right-[10%] top-[20%]" aria-hidden="true">✦</span>
    <span class="cosmic-star bottom-[13%] right-[7%]" aria-hidden="true">✦</span>

    <div class="relative z-10 mx-auto flex w-full max-w-5xl flex-col items-center text-center">
      <img
        class="mb-8 size-28 rounded-full border-2 border-violet-400/35 object-cover shadow-[0_0_45px_rgba(168,85,247,0.3)] sm:size-36"
        src="/images/logo-le-coven.jpeg"
        alt="Logo Le Coven"
        width="288"
        height="288"
        fetchpriority="high"
      />

      <p class="c-eyebrow c-eyebrow--pill">
        Association culturelle <span aria-hidden="true">·</span> Musique électronique
      </p>

      <h1 class="hero-title bg-gradient-to-r from-fuchsia-400 via-violet-50 to-fuchsia-400 bg-clip-text text-[clamp(4.5rem,14vw,11rem)] font-black leading-[0.82] tracking-[-0.075em] text-transparent">
        Le Coven
      </h1>

      <p class="mt-10 max-w-2xl text-base leading-8 text-violet-100/65 sm:text-lg">
        Fédération de collectifs underground dédiée à la création, la diffusion et la promotion de la culture électronique et des arts alternatifs.
      </p>

      <div class="mt-10 flex w-full flex-col items-stretch justify-center gap-4 sm:w-auto sm:flex-row sm:items-center">
        <Button href="/events" size="lg">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M7 3v3m10-3v3M4.5 9.5h15M6 5h12a2 2 0 0 1 2 2v12H4V7a2 2 0 0 1 2-2Z"></path>
          </svg>
          Événements
        </Button>

        <Button href="/blue-moon" variant="secondary" size="lg">
          Blue Moon Festival
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
