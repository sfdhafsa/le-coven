---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";

const STRAPI_URL = (import.meta.env.PUBLIC_STRAPI_URL ?? "http://localhost:1337").replace(/\/$/, "");

interface TextChild { type: "text"; text: string; }
interface ContentBlock {
  type: "heading" | "paragraph";
  level?: number;
  children?: TextChild[];
}
interface MediaFormat { url: string; }
interface StrapiImage {
  url: string;
  alternativeText?: string | null;
  formats?: { large?: MediaFormat; medium?: MediaFormat } | null;
}
interface PageEntry {
  titre: string | null;
  slug: string;
  surtitre?: string | null;
  resume?: string | null;
  contenu?: ContentBlock[] | null;
  imageBanniere?: StrapiImage | null;
  titreSeo?: string | null;
  descriptionSeo?: string | null;
}
interface ContentSection {
  title: string;
  paragraphs: string[];
}
interface CollectiveEntry {
  name?: string;
  nom?: string;
  slug?: string;
  shortDescription?: string | null;
  descriptionCourte?: string | null;
  logo?: StrapiImage | null;
  isActive?: boolean | null;
  actif?: boolean | null;
  displayOrder?: number | null;
  ordreAffichage?: number | null;
}
interface PartnerEntry {
  name?: string;
  nom?: string;
  description?: string | null;
  logo?: StrapiImage | null;
  websiteUrl?: string | null;
  siteWeb?: string | null;
}
interface TeamMemberEntry {
  firstName?: string;
  prenom?: string;
  lastName?: string;
  nom?: string;
  role?: string | null;
  fonction?: string | null;
  profession?: string | null;
  photo?: StrapiImage | null;
  isActive?: boolean | null;
  actif?: boolean | null;
  displayOrder?: number | null;
  ordreAffichage?: number | null;
}

const response = await fetch(
  `${STRAPI_URL}/api/pages?filters[slug][$eq]=le-coven&populate=imageBanniere`,
);
if (!response.ok) {
  throw new Error(`Impossible de charger la page Le Coven (${response.status}).`);
}

const payload: { data: PageEntry[] } = await response.json();
const entry = payload.data[0];
if (!entry) return Astro.redirect("/", 302);
const page = {
  title: entry.titre ?? "Le Coven",
  slug: entry.slug,
  eyebrow: entry.surtitre,
  summary: entry.resume,
  content: entry.contenu,
  heroImage: entry.imageBanniere,
  seoTitle: entry.titreSeo,
  seoDescription: entry.descriptionSeo,
};

const blockText = (block: ContentBlock) =>
  block.children?.map((child) => child.text).join("").trim() ?? "";
const sections: ContentSection[] = [];
let currentSection: ContentSection | undefined;

for (const block of page.content ?? []) {
  const text = blockText(block);
  if (!text) continue;
  if (block.type === "heading" && block.level === 2) {
    currentSection = { title: text, paragraphs: [] };
    sections.push(currentSection);
    continue;
  }
  if (block.type === "heading" && block.level === 3) {
    currentSection = { title: text, paragraphs: [] };
    sections.push(currentSection);
    continue;
  }
  if (block.type === "paragraph") {
    if (!currentSection) {
      currentSection = { title: page.title, paragraphs: [] };
      sections.push(currentSection);
    }
    currentSection.paragraphs.push(text);
  }
}

const imagePath = page.heroImage?.formats?.large?.url
  ?? page.heroImage?.formats?.medium?.url
  ?? page.heroImage?.url;
const fallbackHeroUrl = "/images/hero-concert.jfif";
let heroUrl = fallbackHeroUrl;

if (imagePath) {
  const candidateUrl = imagePath.startsWith("http") ? imagePath : `${STRAPI_URL}${imagePath}`;

  try {
    const imageResponse = await fetch(candidateUrl, { method: "HEAD" });
    if (imageResponse.ok) heroUrl = candidateUrl;
  } catch {
    heroUrl = fallbackHeroUrl;
  }
}

const mediaUrl = (image?: StrapiImage | null) => {
  const path = image?.formats?.medium?.url ?? image?.url;
  if (!path) return undefined;
  return path.startsWith("http") ? path : `${STRAPI_URL}${path}`;
};

let teamMembers: Array<{
  firstName: string;
  lastName: string;
  role: string;
  profession: string | null;
  photo: StrapiImage | null;
}> = [];

try {
  const response = await fetch(`${STRAPI_URL}/api/team-members?populate=photo`);
  if (response.ok) {
    const payload: { data?: TeamMemberEntry[] } = await response.json();
    const entries = (payload.data ?? [])
      .filter((member) => member.isActive !== false && member.actif !== false)
      .sort((a, b) => (a.displayOrder ?? a.ordreAffichage ?? 0) - (b.displayOrder ?? b.ordreAffichage ?? 0))
      .map((member) => ({
        firstName: member.firstName ?? member.prenom ?? "",
        lastName: member.lastName ?? member.nom ?? "",
        role: member.role ?? member.fonction ?? "Cour Centrale",
        profession: member.profession ?? null,
        photo: member.photo ?? null,
      }))
      .filter((member) => member.firstName || member.lastName)
      .filter((member) => `${member.firstName} ${member.lastName}`.trim().toLocaleLowerCase("fr") !== "colombe capon")
      .sort((a, b) => {
        const aLaura = `${a.firstName} ${a.lastName}`.trim().toLocaleLowerCase("fr") === "laura dekeyser";
        const bLaura = `${b.firstName} ${b.lastName}`.trim().toLocaleLowerCase("fr") === "laura dekeyser";
        return Number(bLaura) - Number(aLaura);
      });
    if (entries.length > 0) teamMembers = entries;
  }
} catch {
  teamMembers = [];
}

const sectionAnchor = (title: string) => title
  .normalize("NFD")
  .replace(/[\u0300-\u036f]/g, "")
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "");
const editorialSections = sections.filter((section) => {
  const anchor = sectionAnchor(section.title);
  return anchor.includes("mission") || anchor.includes("histoire");
});
const helloAssoUrl = import.meta.env.PUBLIC_HELLOASSO_URL ?? "https://www.helloasso.com/associations/le-coven";
const shopUrl = import.meta.env.PUBLIC_SHOP_URL ?? "https://www.helloasso.com/associations/le-coven/boutiques/blue-moon-festival";
const donateUrl = import.meta.env.PUBLIC_DONATE_URL ?? "https://www.helloasso.com/associations/le-coven/formulaires/1";
---

<BaseLayout
  title={page.seoTitle || `${page.title} — Association`}
  description={page.seoDescription || page.summary || undefined}
>
  <header
    class="association-page-hero"
    style={`--association-hero-image: url('${heroUrl}')`}
  >
    <div class="association-page-hero__star" aria-hidden="true"></div>
    <Container size="wide" class="association-page-hero__content">
      {page.eyebrow && <p class="c-eyebrow">{page.eyebrow}</p>}
      <h1 class="association-page-wordmark">
        <span class="sr-only">{page.title}</span>
        <img src="/images/le-coven-wordmark.png" alt="" width="551" height="207" aria-hidden="true" />
      </h1>
      {page.summary && <p class="association-page-hero__summary">{page.summary}</p>}
    </Container>
  </header>

  <section class="association-membership association-membership--priority" id="adhesion">
    <Container size="wide">
      <div class="association-membership__panel">
        <div>
          <p class="c-eyebrow">Faire vivre le projet</p>
          <h2>Rejoindre l’association</h2>
          <p>Adhérez au Coven, soutenez ses actions et participez à une aventure culturelle collective.</p>
        </div>
        <Button href={helloAssoUrl} size="lg">Adhérer avec HelloAsso</Button>
      </div>
    </Container>
  </section>

  <section class="association-editorial" aria-label="Missions et histoire de l’association">
    <Container size="wide">
      {editorialSections.map((section) => (
        <article id={sectionAnchor(section.title)} class="association-editorial__section">
          <p class="c-eyebrow">Le Coven</p>
          <h2>{section.title}</h2>
          <div>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
        </article>
      ))}
    </Container>
  </section>

  <section class="coven-team" id="cour-centrale">
    <Container size="wide">
      <div class="association-section-heading">
        <p class="c-eyebrow">L’équipe dirigeante</p>
        <h2>La Cour Centrale</h2>
        <p>Une équipe réunie pour faire vivre le projet associatif, culturel et artistique du Coven.</p>
      </div>
      <div class="coven-team__grid">
        {teamMembers.map((member) => (
          <article class:list={["coven-member-card", `${member.firstName} ${member.lastName}`.trim().toLocaleLowerCase("fr") === "laura dekeyser" && "coven-member-card--featured"]}>
            <div class="coven-member-card__portrait">
              {mediaUrl(member.photo) ? (
                <img src={mediaUrl(member.photo)} alt={`${member.firstName} ${member.lastName}`} loading="lazy" />
              ) : (
                <span aria-hidden="true">{member.firstName.charAt(0)}{member.lastName.charAt(0)}</span>
              )}
            </div>
            <p class="coven-member-card__role">{member.role}</p>
            <h3>{member.firstName} {member.lastName}</h3>
            {member.profession && <p class="coven-member-card__profession">{member.profession}</p>}
          </article>
        ))}
      </div>
      {teamMembers.length === 0 && (
        <p class="partner-empty">Aucun membre d’équipe publié n’est actuellement disponible dans Strapi.</p>
      )}
      <div class="coven-thanks coven-thanks--centered">
        <p class="c-eyebrow">Merci</p>
        <p>Le Coven remercie chaleureusement ses adhérent·es, bénévoles, partenaires, salarié·es et prestataires. Leur engagement rend chaque projet possible.</p>
      </div>
    </Container>
  </section>

  <section class="association-links" aria-label="Découvrir la Fédération et ses partenaires">
    <Container size="wide">
      <div class="association-links__grid">
        <a href="/collectifs"><p class="c-eyebrow">La Fédération</p><h2>Nos collectifs</h2><p>Découvrez les membres de la Fédération, leurs univers musicaux et leurs réseaux.</p><span>Voir les collectifs →</span></a>
        <a href="/partenaires"><p class="c-eyebrow">Nos soutiens</p><h2>Partenaires et financeurs</h2><p>Découvrez les structures qui rendent nos projets possibles.</p><span>Voir les partenaires →</span></a>
      </div>
    </Container>
  </section>

  <section class="association-support" id="nous-soutenir">
    <Container size="wide">
      <div class="association-support__panel">
        <div>
          <p class="c-eyebrow">Nous soutenir</p>
          <h2>Faites grandir le Coven</h2>
          <p>Chaque achat et chaque don participe directement au développement de nos projets culturels.</p>
        </div>
        <div class="association-support__actions">
          <a class="c-button c-button--secondary c-button--lg" href={shopUrl} target="_blank" rel="noopener noreferrer">Voir la boutique ↗</a>
          <a class="c-button c-button--primary c-button--lg" href={donateUrl} target="_blank" rel="noopener noreferrer">Faire un don ↗</a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
