{
  "kind": "collectionType",
  "collectionName": "artists",
  "info": {
    "singularName": "artist",
    "pluralName": "artists",
    "displayName": "Artist"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "biography": {
      "type": "blocks"
    },
    "shortBiography": {
      "type": "text"
    },
    "profileImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "genres": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "instagramUrl": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "facebookUrl": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "soundcloudUrl": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "spotifyUrl": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "websiteUrl": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "featured": {
      "type": "boolean",
      "required": true,
      "default": false
    }
  }
}
