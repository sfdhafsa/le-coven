{
  "kind": "collectionType",
  "collectionName": "artists",
  "info": {
    "singularName": "artist",
    "pluralName": "artists",
    "displayName": "Artiste"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nom": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nom",
      "required": true
    },
    "biographie": {
      "type": "blocks"
    },
    "biographieCourte": {
      "type": "text"
    },
    "imageProfil": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "galerie": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "genres": {
      "type": "string"
    },
    "pays": {
      "type": "string"
    },
    "ville": {
      "type": "string"
    },
    "lienInstagram": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "lienFacebook": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "lienSoundcloud": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "lienSpotify": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "lienSiteWeb": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "misEnAvant": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "performances": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::performance.performance",
      "mappedBy": "artiste"
    }
  }
}
