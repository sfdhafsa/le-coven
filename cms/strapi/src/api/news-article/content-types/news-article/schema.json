{
  "kind": "collectionType",
  "collectionName": "news_articles",
  "info": {
    "singularName": "news-article",
    "pluralName": "news-articles",
    "displayName": "Article d'actualité"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "extrait": {
      "type": "text",
      "required": true
    },
    "contenu": {
      "type": "blocks",
      "required": true
    },
    "imageCouverture": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "galerie": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "categorie": {
      "type": "enumeration",
      "enum": [
        "association",
        "event",
        "festival",
        "collective",
        "announcement",
        "partnership",
        "other"
      ]
    },
    "nomAuteur": {
      "type": "string"
    },
    "misEnAvant": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "lienExterne": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "titreSeo": {
      "type": "string"
    },
    "descriptionSeo": {
      "type": "text"
    }
  }
}
