{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Événement",
    "description": "Un événement est une activité organisée par l'association ou un partenaire, qui peut être un concert, un festival, une conférence, un atelier, etc."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "descriptionCourte": {
      "type": "text",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "imageCouverture": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "galerie": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "dateDebut": {
      "type": "datetime",
      "required": true
    },
    "dateFin": {
      "type": "datetime"
    },
    "ouvertureDesPortes": {
      "type": "datetime"
    },
    "lieu": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::venue.venue",
      "inversedBy": "evenements"
    },
    "lieuPersonnalise": {
      "type": "string"
    },
    "evenementEnLigne": {
      "type": "boolean"
    },
    "lienEnLigne": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "categorie": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "concert",
        "festival",
        "party",
        "workshop",
        "meeting",
        "conference",
        "other"
      ]
    },
    "lienFacebook": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "lienShotgun": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "lienBilletterie": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "lienHelloAsso": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "misEnAvant": {
      "type": "boolean",
      "default": false
    },
    "complet": {
      "type": "boolean",
      "default": false
    },
    "annule": {
      "type": "boolean",
      "default": false
    },
    "entreeGratuite": {
      "type": "boolean",
      "default": false
    },
    "informationsTarifaires": {
      "type": "string"
    },
    "ageMinimum": {
      "type": "integer"
    }
  }
}
