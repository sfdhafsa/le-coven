{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "shortDescription": {
      "type": "text",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "startDate": {
      "type": "datetime",
      "required": true
    },
    "endDate": {
      "type": "datetime"
    },
    "doorsOpenAt": {
      "type": "datetime"
    },
    "venue": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::venue.venue",
      "inversedBy": "events"
    },
    "customLocation": {
      "type": "string"
    },
    "onlineEvent": {
      "type": "boolean"
    },
    "onlineUrl": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "concert",
        "festival",
        "party",
        "workshop",
        "meeting",
        "conference",
        "other"
      ]
    },
    "facebookUrl": {
      "type": "string"
    },
    "shotgunUrl": {
      "type": "string"
    },
    "ticketingUrl": {
      "type": "string"
    },
    "helloAssoUrl": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "soldOut": {
      "type": "boolean",
      "default": false
    },
    "cancelled": {
      "type": "boolean",
      "default": false
    },
    "freeEntry": {
      "type": "boolean",
      "default": false
    },
    "priceInformation": {
      "type": "string"
    },
    "minimumAge": {
      "type": "integer"
    }
  }
}
