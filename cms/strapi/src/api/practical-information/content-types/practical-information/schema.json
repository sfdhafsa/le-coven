{
  "kind": "collectionType",
  "collectionName": "practical_informations",
  "info": {
    "singularName": "practical-information",
    "pluralName": "practical-informations",
    "displayName": "Informations pratiques"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titre",
      "required": true
    },
    "categorie": {
      "type": "string"
    },
    "resume": {
      "type": "text"
    },
    "contenu": {
      "type": "blocks",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "lienExterne": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "libelleBouton": {
      "type": "string"
    },
    "ordreAffichage": {
      "type": "integer",
      "default": 0
    },
    "misEnAvant": {
      "type": "boolean",
      "default": false
    },
    "editionFestival": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::festival-edition.festival-edition",
      "inversedBy": "informationsPratiques"
    }
  }
}
