{
  "kind": "collectionType",
  "collectionName": "performances",
  "info": {
    "singularName": "performance",
    "pluralName": "performances",
    "displayName": "Performance"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "dateHeureDebut": {
      "type": "datetime",
      "required": true
    },
    "dateHeureFin": {
      "type": "datetime"
    },
    "nomScene": {
      "type": "string"
    },
    "description": {
      "type": "blocks"
    },
    "annulee": {
      "type": "boolean",
      "default": false
    },
    "miseEnAvant": {
      "type": "boolean",
      "default": false
    },
    "ordreAffichage": {
      "type": "integer",
      "default": 0
    },
    "artiste": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::artist.artist",
      "inversedBy": "performances"
    },
    "editionFestival": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::festival-edition.festival-edition",
      "inversedBy": "performances"
    },
    "lieu": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::venue.venue",
      "inversedBy": "performances"
    }
  }
}
