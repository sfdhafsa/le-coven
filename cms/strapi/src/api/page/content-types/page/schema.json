{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titre"
    },
    "resume": {
      "type": "text"
    },
    "imageBanniere": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "titreSeo": {
      "type": "string"
    },
    "descriptionSeo": {
      "type": "text"
    },
    "visibleDansNavigation": {
      "type": "boolean",
      "default": false
    },
    "ordreNavigation": {
      "type": "integer",
      "default": 0
    },
    "surtitre": {
      "type": "string"
    },
    "contenu": {
      "type": "blocks"
    }
  }
}
