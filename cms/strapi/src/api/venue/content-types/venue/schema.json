{
  "kind": "collectionType",
  "collectionName": "venues",
  "info": {
    "singularName": "venue",
    "pluralName": "venues",
    "displayName": "Lieu"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nom": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nom",
      "required": true
    },
    "adresse": {
      "type": "string"
    },
    "ville": {
      "type": "string",
      "required": true
    },
    "codePostal": {
      "type": "string"
    },
    "pays": {
      "type": "string"
    },
    "description": {
      "type": "richtext"
    },
    "informationsAcces": {
      "type": "richtext"
    },
    "lienCarte": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "lienSiteWeb": {
      "type": "string",
      "regex": "^https?:\\/\\/.+"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "evenements": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event.event",
      "mappedBy": "lieu"
    },
    "editionsFestival": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::festival-edition.festival-edition",
      "mappedBy": "lieux"
    },
    "performances": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::performance.performance",
      "mappedBy": "lieu"
    }
  }
}
